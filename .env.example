# 复制成 .env 并填入你的配置（也可以直接用工作区根目录的 .env）
# .env 已被 .gitignore 排除，永远不会提交

# ============ 模型服务（AI 复盘 + 多智能体判断需要）============
# 支持任何 OpenAI 兼容接口。不配这三行就默认用硅基流动。
# 旧的 SILICONFLOW_API_KEY / SILICONFLOW_MODEL 仍然兼容。

# 方案 A：硅基流动（默认）
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 进阶：分析师和主持人分开配（好钢用在刀刃上，还省钱）
# 分析师干的活简单 -> 用性价比款
LLM_MODEL_ANALYST=deepseek-ai/DeepSeek-V3.2
# 主持人干的活难 -> 用旗舰款
LLM_MODEL_CHAIR=deepseek-ai/DeepSeek-V4-Pro
# 只有这两个都没配时才回退到上面的 LLM_MODEL

# 方案 B：DeepSeek 官方（把上面三行换成这三行）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-你的key
# LLM_MODEL=deepseek-chat

# 方案 C：本地 Ollama（免费、不联网、不用充值）
# 先装 Ollama 并执行：ollama pull qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
# 小模型建议开精简提示词模式（带示例、字段更少，格式更稳）
LLM_PROMPT_MODE=compact

# ============ 交易所只读 Key（可选，想自动同步持仓才需要）============
# ⚠️ 权限只勾「读取」！不要勾提现，不要勾交易！
# 建议再绑定 IP 白名单

# 币安 USDT 本位合约
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 欧易 OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# Bybit
BYBIT_API_KEY=
BYBIT_API_SECRET=
